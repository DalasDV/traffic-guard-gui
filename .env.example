# Для первой настройки TOTP оставьте локальный адрес. После настройки на VPS
# задайте https://ваш-домен без завершающего /.
PANEL_ORIGIN=http://127.0.0.1:4090

# Порт панели на loopback. При смене локального порта обновите и PANEL_ORIGIN.
PANEL_PORT=4090

# Через запятую укажите адреса или CIDR непубличных SSH-хостов, если они нужны.
PANEL_SSH_CIDRS=
